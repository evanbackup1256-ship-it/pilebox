# Build output - regenerated by build_exe.ps1 / publish_release.ps1.
/dist_release/
/flutter_app/build/
/flutter_app/.dart_tool/
/flutter_app/.flutter-plugins-dependencies

# Windows ephemeral plugin symlinks - regenerated by `flutter pub get`.
/flutter_app/windows/flutter/ephemeral/

# Editor/OS noise. .vscode/settings.json is kept (just the CMake source dir).
.idea/
*.iml
Thumbs.db
.DS_Store

# Never commit a local Flutter SDK checkout if one ends up under the repo.
/flutter/

# Claude Code session/tooling state, not project content.
/.claude/

